# API ID is an application identifier, not a bot token. Use your own from https://my.telegram.org
TELEGRAM_API_ID=12345678

# Replace placeholders locally. Never commit your real .env file.
TELEGRAM_API_HASH=replace_with_your_api_hash
TELEGRAM_BOT_TOKEN=replace_with_your_new_bot_token

# Destination numeric peer ID (often starts with -100) or @username.
TELEGRAM_CHANNEL_PEER=-1001234567890

# Place the Telegram Desktop export (HTML pages + media folders) here.
TELEGRAM_EXPORT_DIR=./telegram_export

# Safe default: preview without sending. Change to false only after reviewing.
TELEGRAM_DRY_RUN=true
TELEGRAM_SKIP_CONFIRMATION=false

# Optional tuning (the values shown are the defaults).
# Stop at any message with a file larger than this many MiB; 0 disables the check.
# 2000 MiB is believed to be Telegram's MTProto ceiling; verify it with your bot.
# TELEGRAM_MAX_UPLOAD_MB=2000
# TELEGRAM_BATCH_LIMIT=1000
# TELEGRAM_SEND_DELAY=2.5
# TELEGRAM_SESSION_NAME=colab_bot_restorer_session
